{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/koncepter/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/om-vanta",
      "permanent": true
    },
    {
      "source": "/om",
      "destination": "/om-vanta",
      "permanent": true
    },
    {
      "source": "/om-os",
      "destination": "/om-vanta",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/om-vanta",
      "permanent": true
    }
  ]
}
